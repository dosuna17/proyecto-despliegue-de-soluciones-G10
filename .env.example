# true: resolver el champion en MLflow y sincronizarlo a MODEL_PATH al inferir.
# false: usar el checkpoint local MODEL_PATH sin consultar MLflow.
MODEL_USE_MLFLOW=false
# Carpeta persistente del checkpoint y su metadata; debe permitir escritura.
MODEL_DIR=./modelos
MODEL_MOUNT_PATH=/models
# Destino persistente del checkpoint, actualizado desde MLflow cuando está en true.
MODEL_PATH=/models/flexible_final.pth

# Conexión a MLflow (necesaria cuando MODEL_USE_MLFLOW=true).
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_HTTP_REQUEST_TIMEOUT=15
MLFLOW_ARTIFACT_PATH=modelo_final/flexible_emg_mlp_final.pth

# Tablero (opcionales; si no se definen se usa configs/app.yaml)
TABLERO_UMBRALES_CONFIANZA=
TABLERO_SOLICITUDES_PARALELAS=
TABLERO_SECUENCIAS_POR_SOLICITUD=
TABLERO_TIMEOUT_INFERENCIA_S=
