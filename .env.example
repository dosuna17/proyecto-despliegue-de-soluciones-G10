# Modelo TinySleepNet local (opcional). Si se deja vacío, la API usa MLflow.
MODEL_DIR=./modelos
MODEL_MOUNT_PATH=/models
MODEL_PATH=/models/flexible_final.pth
# Comprueba el run_id local contra MLflow una vez al día.
MODEL_RUN_ID_CHECK_INTERVAL_SECONDS=86400

# Opcional: conexión a MLflow. Se usa cuando MODEL_PATH está vacío.
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_HTTP_REQUEST_TIMEOUT=15
MLFLOW_ARTIFACT_PATH=modelo_final/flexible_final.pth

# Tablero (opcionales; si no se definen se usa configs/app.yaml)
TABLERO_UMBRAL_CONFIANZA=
TABLERO_SOLICITUDES_PARALELAS=
TABLERO_TIMEOUT_INFERENCIA_S=
